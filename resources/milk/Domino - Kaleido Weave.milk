per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time * 0.2;
per_frame_5=zoom = 0.999 + 0.008 * bass_att;
per_frame_6=rot = 0.015 * sin(time * 0.23);
per_frame_7=warp = 0.40 + 0.60 * mid_att;
per_frame_8=decay = 0.940 + 0.045 * treb_att;
per_frame_9=cx = 0.5 + 0.02 * sin(time * 0.31);
per_frame_10=cy = 0.5 + 0.02 * cos(time * 0.29);
per_pixel_1=sixfold = int(ang / 1.0472);
per_pixel_2=rot = rot + 0.04 * sin(sixfold * 1.0472 * 3 + time) * q2;
per_pixel_3=zoom = zoom + 0.008 * cos(rad * 10 - time * 1.5) * q1;
per_pixel_4=warp = warp * (1 + 0.6 * sin(ang * 6));
wave_0_per_frame1=t1 = q4;
wave_0_per_point1=k = sample * 6.283185 * 3 + t1;
wave_0_per_point2=fold = 0.25 + 0.16 * sin(k * 2) + value1 * 0.20;
wave_0_per_point3=x = 0.5 + cos(k) * fold * 0.75;
wave_0_per_point4=y = 0.5 + sin(k) * fold;
wave_0_per_point5=r = 0.4 + 0.6 * abs(sin(k * 0.5));
wave_0_per_point6=g = 0.9;
wave_0_per_point7=b = 0.5 + 0.5 * cos(k * 0.5);
