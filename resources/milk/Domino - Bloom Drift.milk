[preset00]
fRating=4.000
fGammaAdj=1.000
fDecay=0.980
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=1
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=1
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.900
fWaveScale=1.300
fWaveSmoothing=0.750
fWaveParam=0.200
fModWaveAlphaStart=0.600
fModWaveAlphaEnd=1.400
fWarpAnimSpeed=0.700
fWarpScale=2.100
fZoomExponent=1.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
zoom=1.004
rot=0.006
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.350
sx=1.000
sy=1.000
wave_r=0.900
wave_g=0.500
wave_b=1.000
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_a=0.000
ib_size=0.000
ib_a=0.000
per_frame_1=vol = (bass_att + mid_att + treb_att) * 0.333;
per_frame_2=q1 = bass_att;
per_frame_3=q2 = treb_att;
per_frame_4=q3 = 0.5 + 0.5 * sin(time * 0.19);
per_frame_5=zoom = 1.002 + 0.010 * bass_att;
per_frame_6=rot = 0.004 * sin(time * 0.13);
per_frame_7=warp = 0.20 + 0.35 * mid_att;
per_frame_8=wave_r = 0.5 + 0.5 * sin(time * 0.41);
per_frame_9=wave_g = 0.5 + 0.5 * sin(time * 0.33 + 2.0);
per_frame_10=wave_b = 0.5 + 0.5 * sin(time * 0.27 + 4.0);
per_pixel_1=zoom = zoom + 0.004 * cos(rad * 6.0 - time);
warp_1=`shader_body
warp_2=`{
warp_3=`    float2 d = uv - 0.5;
warp_4=`    float r = length(d) + 0.0001;
warp_5=`
warp_6=`    // Swirl: rotate more the closer a pixel is to the centre.
warp_7=`    float swirl = 0.010 * (1.0 - r) * (0.5 + q1);
warp_8=`    float s = sin(swirl);
warp_9=`    float c = cos(swirl);
warp_10=`    float2 rotated = float2(d.x * c - d.y * s, d.x * s + d.y * c);
warp_11=`
warp_12=`    float2 uv2 = rotated + 0.5;
warp_13=`    float3 col = tex2D(sampler_main, uv2).xyz;
warp_14=`
warp_15=`    // Slight chromatic separation along the radius.
warp_16=`    float2 off = d / r * 0.0012 * (0.4 + q2);
warp_17=`    col.r = tex2D(sampler_main, uv2 + off).x;
warp_18=`    col.b = tex2D(sampler_main, uv2 - off).z;
warp_19=`
warp_20=`    ret = col * 0.982;
warp_21=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float3 base = tex2D(sampler_main, uv).xyz;
comp_4=`
comp_5=`    // Bloom from the blur pyramid, weighted toward the wider levels.
comp_6=`    float3 bloom = GetBlur1(uv) * 0.35
comp_7=`                 + GetBlur2(uv) * 0.45
comp_8=`                 + GetBlur3(uv) * 0.55;
comp_9=`
comp_10=`    float3 col = base + bloom * (0.25 + q2 * 0.45);
comp_11=`
comp_12=`    // Gentle vignette so the bloom does not wash out the edges.
comp_13=`    float r = length(uv - 0.5);
comp_14=`    col *= 1.0 - saturate(r * r * 1.1);
comp_15=`
comp_16=`    ret = pow(saturate(col), float3(0.90, 0.92, 0.95));
comp_17=`}
