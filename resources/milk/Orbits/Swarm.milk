shape_0_per_frame1=orbit = q4 * 0.4284 * 1 + instance * 0.5712;
shape_0_per_frame2=dist = 0.1523 + 0.1000 * sin(q4 * 0.4896 + instance);
shape_0_per_frame3=x = 0.5 + cos(orbit) * dist * 0.8;
shape_0_per_frame4=y = 0.5 + sin(orbit) * dist;
shape_0_per_frame5=rad = 0.0265 + 0.0400 * q1 + instance * 0.0015;
shape_0_per_frame6=ang = orbit * 1.7;
shape_0_per_frame7=r = 0.350 * (0.5 + 0.5 * sin(instance * 0.9 + q4 * 0.5));
shape_0_per_frame8=g = 0.850 * (0.5 + 0.5 * sin(instance * 0.9 + q4 * 0.5 + 2.1));
shape_0_per_frame9=b = 0.100 * (0.5 + 0.5 * sin(instance * 0.9 + q4 * 0.5 + 4.2));
shape_0_per_frame10=a = 0.25 + 0.35 * q1;
shape_0_per_frame11=border_a = 0.20 + 0.35 * q3;
per_frame_1=q1 = treb_att;
per_frame_2=q2 = bass_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 1.003 + 0.0120 * q1;
per_frame_6=rot = 0.0060 + 0.0080 * sin(time * 0.2326);
per_frame_7=decay = 0.9768;
per_frame_8=hue = time * 0.2081 + 2.029;
per_frame_9=wave_r = 0.350 * (0.55 + 0.45 * sin(hue));
per_frame_10=wave_g = 0.850 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_11=wave_b = 0.100 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=rot = rot + 0.0200 * (0.5 - rad) * q2;
