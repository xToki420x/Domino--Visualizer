[preset00]
fRating=3.000
fGammaAdj=1.200
fDecay=0.985
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=1
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.615
fWaveScale=1.200
fWaveSmoothing=0.700
fWaveParam=0.000
fModWaveAlphaStart=0.700
fModWaveAlphaEnd=1.300
fWarpAnimSpeed=0.288
fWarpScale=3.649
fZoomExponent=1.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
zoom=1.000
rot=0.000
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.450
sx=1.000
sy=1.000
wave_r=1.000
wave_g=1.000
wave_b=1.000
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
per_frame_1=q1 = mid_att;
per_frame_2=q2 = treb_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 1.0002 + -0.0050 * q1;
per_frame_6=dx = 0.0012 * sin(time * 0.0504);
per_frame_7=dy = 0.0012 * cos(time * 0.0396);
per_frame_8=warp = 0.30 + 0.40 * q2;
per_frame_9=decay = 0.9850;
per_frame_10=hue = time * 0.0613 + 3.846;
per_frame_11=wave_r = 0.350 * (0.55 + 0.45 * sin(hue));
per_frame_12=wave_g = 0.600 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_13=wave_b = 0.150 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=zoom = zoom + 0.0025 * sin(rad * 8.0000 + time * 0.2162);
warp_1=`shader_body
warp_2=`{
warp_3=`   float2 d = uv - 0.5;
warp_4=`   float2 n = tex2D(sampler_noise_lq, uv * 0.906 + time * 0.0072).xy - 0.5;
warp_5=`   float2 uv2 = uv + n * 0.00252 * (0.4 + q1);
warp_6=`   float3 col = tex2D(sampler_main, uv2).xyz;
warp_7=`   ret = col * decay;
warp_8=`}
comp_1=`shader_body
comp_2=`{
comp_3=`   float3 base = tex2D(sampler_main, uv).xyz;
comp_4=`   float3 col = base + GetBlur2(uv) * (0.22 + q2 * 0.3);
comp_5=`   float r = length(uv - 0.5);
comp_6=`   col *= 1.0 - saturate(r * r * 1.1);
comp_7=`   ret = col;
comp_8=`}
