[preset00]
fRating=3.000
fGammaAdj=1.200
fDecay=0.957
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=6
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.629
fWaveScale=1.200
fWaveSmoothing=0.700
fWaveParam=0.000
fModWaveAlphaStart=0.700
fModWaveAlphaEnd=1.300
fWarpAnimSpeed=1.000
fWarpScale=1.300
fZoomExponent=2.320
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
zoom=0.980
rot=0.000
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.050
sx=1.000
sy=1.000
wave_r=1.000
wave_g=1.000
wave_b=1.000
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 0.9880 + -0.0300 * q1;
per_frame_6=rot = -0.0033 * sin(time * 0.0744);
per_frame_7=decay = 0.9574 + 0.012 * q3;
per_frame_8=cx = 0.5 + 0.0289 * sin(time * 0.0355);
per_frame_9=cy = 0.5 + 0.0289 * cos(time * 0.0306);
per_frame_10=hue = time * 0.1405 + 5.491;
per_frame_11=wave_r = 0.850 * (0.55 + 0.45 * sin(hue));
per_frame_12=wave_g = 1.000 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_13=wave_b = 0.450 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=zoomexp = 2.3400 + 0.7 * q1;
per_pixel_2=zoom = zoom + -0.0140 * (1 - rad) * q1;
warp_1=`shader_body
warp_2=`{
warp_3=`   float2 d = uv - 0.5;
warp_4=`   float r = length(d) + 0.0001;
warp_5=`   float2 dir = d / r;
warp_6=`   float sep = 0.00091 * (0.3 + q3);
warp_7=`   float3 col;
warp_8=`   col.x = tex2D(sampler_main, uv + dir * sep).x;
warp_9=`   col.y = tex2D(sampler_main, uv).y;
warp_10=`   col.z = tex2D(sampler_main, uv - dir * sep).z;
warp_11=`   ret = col * decay;
warp_12=`}
comp_1=`shader_body
comp_2=`{
comp_3=`   float3 base = tex2D(sampler_main, uv).xyz;
comp_4=`   float3 bloom = GetBlur2(uv) * 0.45 + GetBlur3(uv) * 0.65;
comp_5=`   float3 col = base + bloom * (0.375 + q1 * 0.4);
comp_6=`   float r = length(uv - 0.5);
comp_7=`   col *= 1.0 - saturate(r * r * 1.3);
comp_8=`   ret = col;
comp_9=`}
