per_frame_1=q1 = mid_att;
per_frame_2=q2 = treb_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 1.0015 + 0.0080 * q1;
per_frame_6=rot = 0.0050 * sin(time * 0.0486);
per_frame_7=warp = 0.15 + 0.35 * q2;
per_frame_8=decay = 0.9779;
per_frame_9=hue = time * 0.1032 + 4.417;
per_frame_10=wave_r = 1.000 * (0.55 + 0.45 * sin(hue));
per_frame_11=wave_g = 1.000 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_12=wave_b = 0.350 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=zoom = zoom + 0.003 * sin(rad * 12.0000 + time * 0.3644);
comp_1=`shader_body
comp_2=`{
comp_3=`   float3 base = tex2D(sampler_main, uv).xyz;
comp_4=`   float3 bloom = GetBlur1(uv) * 0.441
comp_5=`                + GetBlur2(uv) * 0.5
comp_6=`                + GetBlur3(uv) * 0.7;
comp_7=`   float3 col = base + bloom * (0.30 + q1 * 0.611);
comp_8=`   float r = length(uv - 0.5);
comp_9=`   col *= 1.0 - saturate(r * r * 1.0);
comp_10=`   ret = pow(saturate(col), float3(0.92, 0.94, 0.96));
comp_11=`}
