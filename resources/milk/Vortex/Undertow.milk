per_frame_1=q1 = mid_att;
per_frame_2=q2 = treb_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 1.001 + -0.0100 * q1;
per_frame_6=rot = 0.0103 + 0.0140 * sin(time * 0.1117);
per_frame_7=warp = 0.15 + 0.45 * q2;
per_frame_8=decay = 0.9694;
per_frame_9=hue = time * 0.1461 + 1.061;
per_frame_10=wave_r = 0.350 * (0.55 + 0.45 * sin(hue));
per_frame_11=wave_g = 0.600 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_12=wave_b = 0.150 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=rot = rot + 0.0516 * (1 - rad) * q1;
per_pixel_2=zoom = zoom + 0.006 * sin(ang * 4 + time * 0.7733) * q2;
warp_1=`shader_body
warp_2=`{
warp_3=`   float2 d = uv - 0.5;
warp_4=`   float r = length(d) + 0.0001;
warp_5=`   float swirl = 0.01203 * (1.0 - r) * (0.4 + q1);
warp_6=`   float s = sin(swirl);
warp_7=`   float c = cos(swirl);
warp_8=`   float2 uv2 = float2(d.x * c - d.y * s, d.x * s + d.y * c) + 0.5;
warp_9=`   ret = tex2D(sampler_main, uv2).xyz * decay;
warp_10=`}
