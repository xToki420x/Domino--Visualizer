per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=q3 = treb_att;
per_frame_4=zoom = 0.997 + 0.006 * bass_att;
per_frame_5=rot = 0.010 * sin(time * 0.27);
per_frame_6=warp = 0.03 + 0.10 * treb_att;
per_frame_7=decay = 0.945 + 0.030 * mid_att;
per_pixel_1=zoom = zoom + 0.003 * sin(x * 12 + time) * cos(y * 12 - time);
wave_0_per_frame1=t1 = 0.5 + 0.2 * sin(time * 0.4);
wave_0_per_frame2=t2 = 0.5 + 0.2 * cos(time * 0.31);
wave_0_per_point1=ang = sample * 6.283185 * 2 + time * 0.3;
wave_0_per_point2=r = 0.18 + 0.14 * q1 + value1 * 0.22;
wave_0_per_point3=x = t1 + r * cos(ang) * 0.75;
wave_0_per_point4=y = t2 + r * sin(ang);
wave_0_per_point5=r = 0.4 + 0.6 * abs(value1);
wave_0_per_point6=g = 0.9;
wave_0_per_point7=b = 0.5 + 0.5 * sin(sample * 6.283185 + time);
wave_1_per_point1=x = 0.06 + sample * 0.88;
wave_1_per_point2=y = 0.88 - value1 * 0.55 * q3;
wave_1_per_point3=r = 1;
wave_1_per_point4=g = 0.3 + 0.6 * sample;
wave_1_per_point5=b = 0.9;
