per_frame_1=q1 = treb_att;
per_frame_2=q2 = bass_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 0.9920 + -0.0200 * q1;
per_frame_6=rot = 0.0020 * sin(time * 0.0352);
per_frame_7=decay = 0.9850;
per_frame_8=hue = time * 0.0479 + 4.512;
per_frame_9=wave_r = 0.150 * (0.55 + 0.45 * sin(hue));
per_frame_10=wave_g = 0.250 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_11=wave_b = 0.550 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=zoomexp = 2.4000 + 0.6 * q1;
per_pixel_2=zoom = zoom + 0.008 * (1 - rad) * q1;
comp_1=`shader_body
comp_2=`{
comp_3=`   float3 base = tex2D(sampler_main, uv).xyz;
comp_4=`   float3 bloom = GetBlur2(uv) * 0.345 + GetBlur3(uv) * 0.517;
comp_5=`   float3 col = base + bloom * (0.184 + q2 * 0.253);
comp_6=`   float l = lum(col);
comp_7=`   float3 shadow = float3(0.55, 0.30, 1.00);
comp_8=`   float3 light = float3(0.15, 0.65, 0.30);
comp_9=`   col *= lerp(shadow, light, saturate(l * 1.7));
comp_10=`   float r = length(uv - 0.5);
comp_11=`   col *= 1.0 - saturate(r * r * 1.5);
comp_12=`   ret = col;
comp_13=`}
