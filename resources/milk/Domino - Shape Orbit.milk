per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 1.004 + 0.014 * bass_att;
per_frame_6=rot = 0.008 * sin(time * 0.21) + 0.004;
per_frame_7=warp = 0.08 + 0.20 * mid_att;
per_frame_8=decay = 0.920 + 0.050 * treb_att;
per_pixel_1=rot = rot + 0.02 * (0.5 - rad) * q2;
shape_0_per_frame1=orbit = q4 * 0.35 + instance * 0.8975;
shape_0_per_frame2=dist = 0.14 + 0.12 * sin(q4 * 0.4 + instance);
shape_0_per_frame3=x = 0.5 + cos(orbit) * dist * 0.8;
shape_0_per_frame4=y = 0.5 + sin(orbit) * dist;
shape_0_per_frame5=rad = 0.030 + 0.045 * q1 + 0.010 * instance;
shape_0_per_frame6=ang = orbit * 1.7;
shape_0_per_frame7=r = 0.5 + 0.5 * sin(instance * 0.9 + q4 * 0.5);
shape_0_per_frame8=g = 0.5 + 0.5 * sin(instance * 0.9 + q4 * 0.5 + 2.1);
shape_0_per_frame9=b = 0.5 + 0.5 * sin(instance * 0.9 + q4 * 0.5 + 4.2);
shape_0_per_frame10=a = 0.35 + 0.35 * q1;
shape_0_per_frame11=border_a = 0.25 + 0.35 * q3;
shape_1_per_frame1=rad = 0.26 + 0.10 * q1;
shape_1_per_frame2=a2 = 0.12 + 0.22 * q1;
shape_1_per_frame3=g2 = 0.5 + 0.4 * sin(q4 * 0.3);
