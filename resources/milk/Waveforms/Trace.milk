wave_0_per_frame1=t1 = q4 * 0.2540;
wave_0_per_point1=k = sample * 6.2832 * 2 + t1;
wave_0_per_point2=fold = 0.2575 + 0.1400 * sin(k * 2) + value1 * 0.2646;
wave_0_per_point3=x = 0.5 + cos(k) * fold * 0.75;
wave_0_per_point4=y = 0.5 + sin(k) * fold;
wave_0_per_point5=r = 0.350 * (0.45 + 0.55 * abs(value1));
wave_0_per_point6=g = 0.850 * (0.5 + 0.5 * sin(k * 0.5));
wave_0_per_point7=b = 0.100 * (0.5 + 0.5 * cos(k * 0.5));
wave_1_per_point1=x = 0.05 + sample * 0.90;
wave_1_per_point2=y = 0.90 - value1 * 0.5792 * q3;
wave_1_per_point3=r = 1.000;
wave_1_per_point4=g = 1.000 * (0.4 + 0.6 * sample);
wave_1_per_point5=b = 0.450;
per_frame_1=q1 = treb_att;
per_frame_2=q2 = bass_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 0.998 + 0.0060 * q1;
per_frame_6=rot = 0.0080 * sin(time * 0.2286);
per_frame_7=decay = 0.9497;
per_frame_8=hue = time * 0.1439 + 4.060;
per_frame_9=wave_r = 0.350 * (0.55 + 0.45 * sin(hue));
per_frame_10=wave_g = 0.850 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_11=wave_b = 0.100 * (0.55 + 0.45 * sin(hue + 4.19));
per_frame_12=ib_r = wave_r; ib_g = wave_g; ib_b = wave_b;
per_pixel_1=zoom = zoom + 0.003 * sin(x * 13.0000 + time) * cos(y * 13.0000 - time);
