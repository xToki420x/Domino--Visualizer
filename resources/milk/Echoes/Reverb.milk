per_frame_1=q1 = treb_att;
per_frame_2=q2 = bass_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 0.9995 + 0.0090 * q1;
per_frame_6=rot = 0.0100 * sin(time * 0.1211);
per_frame_7=echo_alpha = 0.28 + 0.24 * q2;
per_frame_8=echo_zoom = 1.0150 + 0.02 * q1;
per_frame_9=decay = 0.9378;
per_frame_10=hue = time * 0.1211 + 5.461;
per_frame_11=wave_r = 0.350 * (0.55 + 0.45 * sin(hue));
per_frame_12=wave_g = 0.850 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_13=wave_b = 0.100 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=zoom = zoom + 0.005 * sin(ang * 5 + time * 0.4985) * q1;
