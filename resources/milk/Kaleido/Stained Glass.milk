per_frame_1=q1 = mid_att;
per_frame_2=q2 = treb_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 0.999 + -0.0080 * q1;
per_frame_6=rot = 0.0140 * sin(time * 0.2696);
per_frame_7=warp = 0.30 + 0.55 * q2;
per_frame_8=decay = 0.9609;
per_frame_9=hue = time * 0.2183 + 3.860;
per_frame_10=wave_r = 0.300 * (0.55 + 0.45 * sin(hue));
per_frame_11=wave_g = 0.750 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_12=wave_b = 0.200 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=wedge = int(ang / 1.5708);
per_pixel_2=rot = rot + 0.0450 * sin(wedge * 1.5708 * 3 + time) * q2;
per_pixel_3=zoom = zoom + 0.007 * cos(rad * 12.0000 - time * 1.7975) * q1;
per_pixel_4=warp = warp * (1 + 0.6 * sin(ang * 4));
