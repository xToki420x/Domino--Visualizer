per_frame_init_1=spin = 0;
per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=q3 = treb_att;
per_frame_4=spin = spin + 0.004 * (0.4 + bass_att);
per_frame_5=q4 = spin;
per_frame_6=zoom = 1.006 + 0.018 * bass_att;
per_frame_7=rot = 0.020 + 0.020 * sin(time * 0.17);
per_frame_8=warp = 0.15 + 0.30 * treb_att;
per_frame_9=decay = 0.955 + 0.035 * mid_att;
per_frame_10=wave_r = 0.5 + 0.5 * sin(spin * 1.3);
per_frame_11=wave_g = 0.5 + 0.5 * sin(spin * 1.3 + 2.1);
per_frame_12=wave_b = 0.5 + 0.5 * sin(spin * 1.3 + 4.2);
per_pixel_1=rot = rot + 0.05 * (1 - rad) * q1;
per_pixel_2=zoom = zoom + 0.010 * sin(ang * 3 + time * 0.8) * q2;
shape_0_per_frame1=arm = instance * 0.3927 + q4;
shape_0_per_frame2=dist = 0.05 + instance * 0.026;
shape_0_per_frame3=x = 0.5 + cos(arm) * dist * 0.8;
shape_0_per_frame4=y = 0.5 + sin(arm) * dist;
shape_0_per_frame5=rad = 0.012 + 0.030 * q1 + instance * 0.0018;
shape_0_per_frame6=ang = arm * 2.0;
shape_0_per_frame7=r = 0.5 + 0.5 * sin(instance * 0.4 + q4);
shape_0_per_frame8=g = 0.5 + 0.5 * sin(instance * 0.4 + q4 + 2.1);
shape_0_per_frame9=b = 0.5 + 0.5 * sin(instance * 0.4 + q4 + 4.2);
shape_0_per_frame10=a = 0.15 + 0.30 * q2;
