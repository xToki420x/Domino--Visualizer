per_frame_init_1=q8 = 0;
per_frame_1=vol = (bass_att + mid_att + treb_att) * 0.333;
per_frame_2=q1 = vol;
per_frame_3=q2 = bass_att;
per_frame_4=zoom = 1.008 + 0.030 * bass_att;
per_frame_5=rot = 0.020 * sin(time * 0.31) + 0.012 * (mid_att - 1);
per_frame_6=wave_r = 0.50 + 0.50 * sin(time * 0.71);
per_frame_7=wave_g = 0.50 + 0.50 * sin(time * 0.53 + 2.1);
per_frame_8=wave_b = 0.50 + 0.50 * sin(time * 0.37 + 4.2);
per_frame_9=decay = 0.940 + 0.045 * treb_att;
per_frame_10=warp = 0.10 + 0.45 * bass_att;
per_frame_11=cx = 0.5 + 0.03 * sin(time * 0.23);
per_frame_12=cy = 0.5 + 0.03 * cos(time * 0.19);
per_frame_13=q8 = q8 + 0.01 * bass_att;
per_pixel_1=zoom = zoom + 0.020 * sin(rad * 8 - time * 2) * q2;
per_pixel_2=rot = rot + 0.030 * (rad - 0.5) * q1;
per_pixel_3=warp = warp * (1 + 0.5 * sin(ang * 3 + time));
