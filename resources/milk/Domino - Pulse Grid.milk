per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 0.998 + 0.010 * bass_att;
per_frame_6=dx = 0.0008 * sin(time * 0.4);
per_frame_7=dy = 0.0008 * cos(time * 0.33);
per_frame_8=decay = 0.930 + 0.050 * mid_att;
per_frame_9=warp = 0.01 + 0.05 * treb_att;
per_frame_10=mv_a = 0.10 + 0.30 * treb_att;
per_pixel_1=zoom = zoom + 0.004 * sin(x * 18 + time * 1.2) * cos(y * 18 - time) * q2;
shape_0_per_frame1=col = instance % 5;
shape_0_per_frame2=row = int(instance / 5);
shape_0_per_frame3=x = 0.14 + col * 0.18;
shape_0_per_frame4=y = 0.14 + row * 0.18;
shape_0_per_frame5=phase = col * 0.7 + row * 0.5;
shape_0_per_frame6=lvl = 0.5 + 0.5 * sin(q4 * 1.6 + phase);
shape_0_per_frame7=rad = 0.020 + 0.045 * lvl * (0.4 + q1);
shape_0_per_frame8=ang = q4 * 0.5 + phase;
shape_0_per_frame9=g2 = 0.4 + 0.6 * lvl;
shape_0_per_frame10=b2 = 0.9;
shape_0_per_frame11=a2 = 0.10 + 0.35 * lvl * q1;
shape_0_per_frame12=border_a = 0.25 + 0.45 * lvl;
