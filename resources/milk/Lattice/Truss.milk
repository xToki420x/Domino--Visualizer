per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=zoom = 0.9985 + -0.0100 * q1;
per_frame_6=dx = 0.0015 * sin(time * 0.6622);
per_frame_7=dy = 0.0015 * cos(time * 0.5464);
per_frame_8=decay = 0.9322 + 0.03 * q2;
per_frame_9=hue = time * 0.2815 + 0.843;
per_frame_10=wave_r = 0.850 * (0.55 + 0.45 * sin(hue));
per_frame_11=wave_g = 1.000 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_12=wave_b = 0.450 * (0.55 + 0.45 * sin(hue + 4.19));
per_frame_13=ib_r = wave_r; ib_g = wave_g; ib_b = wave_b;
per_pixel_1=zoom = zoom + 0.005 * sin(x * 24.0 + time * 1.8212) * cos(y * 24.0 - time * 1.4901) * q2;
