per_frame_1=q1 = treb_att;
per_frame_2=q2 = bass_att;
per_frame_3=q3 = treb_att;
per_frame_4=q4 = time;
per_frame_5=kick = pow(min(q1 * 0.75, 1.4), 3.0);
per_frame_6=zoom = 1.0040 + 0.0550 * kick;
per_frame_7=rot = 0.0200 * kick;
per_frame_8=decay = 0.9271 + 0.04 * kick;
per_frame_9=mv_a = 0.08 + 0.35 * q3;
per_frame_10=mv_r = wave_r; mv_g = wave_g; mv_b = wave_b;
per_frame_11=hue = time * 0.1207 + 4.392;
per_frame_12=wave_r = 0.350 * (0.55 + 0.45 * sin(hue));
per_frame_13=wave_g = 0.850 * (0.55 + 0.45 * sin(hue + 2.09));
per_frame_14=wave_b = 0.100 * (0.55 + 0.45 * sin(hue + 4.19));
per_pixel_1=zoom = zoom + 0.010 * (1 - rad) * q1;
