{
  "name": "domino",
  "version": "0.5.2",
  "description": "Domino - a music visualizer that listens to everything your computer plays. Shadertoy-class shader editing and a from-scratch MilkDrop engine.",
  "author": "Jesse",
  "license": "MIT",
  "homepage": "https://github.com/xToki420x/Domino--Visualizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xToki420x/Domino--Visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/xToki420x/Domino--Visualizer/issues"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "test:eel": "esbuild test/eel.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/eel.test.cjs --log-level=warning && node node_modules/.cache/eel.test.cjs",
    "test:milk": "esbuild test/milk.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/milk.test.cjs --log-level=warning && node node_modules/.cache/milk.test.cjs",
    "test:smoke": "electron test/smoke.cjs",
    "test": "npm run test:eel && npm run test:milk && npm run test:shader && npm run test:import",
    "test:shader": "esbuild test/shader.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/shader.test.cjs --log-level=warning && node node_modules/.cache/shader.test.cjs",
    "gen:presets": "node tools/generate-presets.mjs",
    "gen:icon": "electron tools/make-icon.cjs",
    "test:import": "esbuild test/import.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/import.test.cjs --log-level=warning && node node_modules/.cache/import.test.cjs",
    "build:native": "node tools/build-native.mjs",
    "test:native": "node test/native.test.cjs",
    "test:vcam": "electron test/vcam.e2e.cjs"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^12.4.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.domino.visualizer",
    "productName": "Domino",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources",
          "to": "resources"
        },
        {
          "from": "native/build/Release",
          "to": "native",
          "filter": [
            "domino_vcam.node",
            "domino_vcam_source.dll"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Domino",
      "artifactName": "Domino-Setup-${version}.${ext}",
      "uninstallDisplayName": "Domino"
    },
    "portable": {
      "artifactName": "Domino-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Music visualizer with Shadertoy shaders and a MilkDrop engine",
      "description": "Domino listens to everything your computer plays and visualizes it, with live Shadertoy-compatible shader editing and a from-scratch MilkDrop engine.",
      "maintainer": "Jesse <beertoki@gmail.com>",
      "desktop": {
        "entry": {
          "Name": "Domino",
          "Comment": "Music visualizer",
          "Categories": "AudioVideo;Audio;Player;Graphics;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Domino-${version}-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "domino_${version}_amd64.${ext}",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libasound2 | libasound2t64"
      ]
    },
    "pacman": {
      "artifactName": "domino-${version}-x86_64.${ext}"
    },
    "publish": null
  },
  "productName": "Domino"
}
